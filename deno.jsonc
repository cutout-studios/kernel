{
  "name": "@cutout/kernel",
  "version": "0.0.5",
  "exports": {
    "./jsx-runtime": "./jsx/module.ts",
    "./tokens": "./jsx/tokens/module.ts",
    "./projections": "./jsx/projections/module.ts"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "license": "MIT",
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order"
    ]
  },
  "workspace": [
    "jsx",
    "experimental/store",
    "experimental/tauri"
  ]
}
