{
  "name": "@cutout/kernel",
  "version": "0.0.1",
  "exports": {
    "./document": "./document/module.ts",
    "./document/store": "./document/store/module.ts",
    "./element": "./element/module.ts",
    "./element/stylesheet": "./element/stylesheet/module.ts",
    "./jsx": "./jsx/module.ts",
    "./jsx-runtime": "./jsx/module.ts",
    "./jsx/jsx-runtime": "./jsx/module.ts",
    "./jsx/projection": "./jsx/projection/module.ts",
    "./jsx/token": "./jsx/token/module.ts",
    // "./server": "./server/module.ts",
    // "./server/response": "./server/response/module.ts",
    "./selector": "./selector/module.ts"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "license": "MIT",
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order"
    ]
  },
  "imports": {
    "@internal": "./internal/module.ts",

    "@std/assert": "jsr:@std/assert",
    "@std/testing": "jsr:@std/testing"
  },
  "tasks": {
    "docs:lint": "deno doc --lint ./**/module.ts",
    "bundle:size": "bash ./.github/workflows/scripts/getBundleSizes.sh"
  }
}
