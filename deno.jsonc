{
  "name": "@cutout/kernel",
  "version": "0.0.5",
  "exports": {
    "./element": "./element/module.ts",
    "./jsx-runtime": "./jsx/module.ts",
    "./jsx/jsx-runtime": "./jsx/module.ts",
    "./jsx/projections": "./jsx/projections/module.ts",
    "./jsx/tokens": "./jsx/tokens/module.ts",
    "./server": "./server/module.ts",
    "./store": "./store/module.ts",
    "./store/backend": "./store/backend/module.ts",
    "./store/selector": "./store/selector/module.ts"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "license": "MIT",
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert",
    "@std/testing": "jsr:@std/testing",
  },
  "tasks": {
    "docs:lint": "deno doc --lint ./**/module.ts"
  }
}
