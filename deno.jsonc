{
  "exports": {
    ".": "./core/module.ts",
    "./experimental": "./experimental/module.ts",
    "./jsx-runtime": "./core/jsx.ts"
  },
  "imports": {
    "__internal__": "./core/__internal__/module.ts",
    "@std/testing": "jsr:@std/testing",
    "@std/assert": "jsr:@std/assert"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "license": "MIT",
  "lint": {
    "plugins": [
      "jsr:@ayk/lint-import-order"
    ]
  },
  "name": "@cutout/kernel",
  "version": "0.0.6"
  // TODO: add tauri test script
}
